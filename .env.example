# ===================================================
# BITEHOUR PAKISTAN — ENVIRONMENT VARIABLES TEMPLATE
# ===================================================

# Server & Port
NODE_ENV=production
PORT=5000

# Frontend API URL (Leave unset or /api on Vercel same-origin; set full URL if backend is on Render/Railway)
VITE_API_BASE_URL=/api

# Allowed Frontend Origins (comma-separated)
CLIENT_URL=https://www.bitehour.pk

# MongoDB Atlas Connection String (add 0.0.0.0/0 in Atlas Network Access for cloud hosting)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bitehour_db?retryWrites=true&w=majority

# Strong Random JWT Signing Secret (32+ chars)
JWT_SECRET=replace_with_a_strong_32_plus_char_secret
